{
  "name": "@blacklight/core",
  "version": "0.0.0",
  "description": "Blacklight Engine runtime: game loop, scenes, objects, input, audio.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js",
      "default": "./dist/config.js"
    },
    "./debug": {
      "types": "./dist/debug.d.ts",
      "import": "./dist/debug.js",
      "default": "./dist/debug.js"
    },
    "./schema/anim.schema.json": "./schema/anim.schema.json",
    "./schema/layout.schema.json": "./schema/layout.schema.json",
    "./schema/timeline.schema.json": "./schema/timeline.schema.json"
  },
  "files": [
    "dist",
    "schema"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "update:gamepads": "node scripts/update-gamecontrollerdb.js"
  },
  "dependencies": {
    "motion": "14.8.0",
    "pixi.js": "8.22.0"
  },
  "devDependencies": {
    "tsup": "9.0.0",
    "typescript": "6.0.3"
  }
}
