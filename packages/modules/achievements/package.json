{
  "name": "@blacklight/module-achievements",
  "version": "1.1.0",
  "description": "Achievements and leaderboards for Blacklight Engine games: Steam, Game Center, Google Play Games or the reference server.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "blacklight",
    "blacklight-module",
    "achievements"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "blacklight": {
    "module": "achievements",
    "engine": ">=0.0.0 <2.0.0",
    "platforms": [
      "web",
      "desktop",
      "android",
      "ios"
    ],
    "permissions": [
      "network",
      "storage"
    ],
    "dependencies": [
      "http"
    ]
  },
  "peerDependencies": {
    "@blacklight/core": "workspace:*",
    "@blacklight/module-http": "workspace:*"
  },
  "devDependencies": {
    "@blacklight/core": "workspace:*",
    "@blacklight/module-http": "workspace:*",
    "tsup": "9.0.0",
    "typescript": "6.0.3"
  }
}
