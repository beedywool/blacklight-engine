  },
  "dependencies": {
    "@dimforge/rapier2d-compat": "0.21.0"
  },
  "devDependencies": {
    "@blacklight/core": "workspace:*",
    "tsup": "9.0.0",
    "typescript": "6.0.3"
  }
}
