{
  "name": "@blacklight/cli",
  "version": "0.0.0",
  "description": "The `blacklight` command: create, dev, build.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "blacklight": "./dist/cli.js"
  },
  "exports": {
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "6.0.10",
    "cac": "7.1.0",
    "create-blacklight": "workspace:*",
    "magic-string": "1.4.5",
    "pngjs": "7.0.0",
    "vite": "8.3.5",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pngjs": "6.0.5",
    "tsup": "9.0.0",
    "typescript": "6.0.3"
  }
}
