{
  "name": "create-blacklight",
  "version": "1.1.0",
  "description": "Create a Blacklight Engine game from a GitHub release of the engine.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "create-blacklight": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/scaffold.d.ts",
      "import": "./dist/scaffold.js"
    }
  },
  "files": [
    "dist",
    "shared",
    "templates"
  ],
  "scripts": {
    "build": "tsup && node scripts/copy-templates.js",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsup": "9.0.0",
    "typescript": "6.0.3",
    "yaml": "2.9.1"
  }
}
